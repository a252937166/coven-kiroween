    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "shamir-secret-sharing": "0.0.4"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "fast-check": "4.10.2",
    "typescript": "5.9.3"
  }
}
